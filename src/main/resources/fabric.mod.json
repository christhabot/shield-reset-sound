			"io.github.christhabot.shield_reset_sound.ShieldResetSound"
		],
		"client": [
			"io.github.christhabot.shield_reset_sound.ShieldResetSoundClient"
		],
		"modmenu": [
			"io.github.christhabot.shield_reset_sound.ShieldResetSoundModMenuIntegration"
		]
